{
  "dependencies": {
    "@pracht/adapter-cloudflare": "^0.7.2",
    "@pracht/capabilities": "^0.3.0",
    "@pracht/core": "^0.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@pracht/cli": "^1.12.0",
    "@pracht/vite-plugin": "^0.11.0",
    "@tailwindcss/vite": "^4.3.3",
    "ffmpeg-static": "^5.3.0",
    "preact": "^10.26.9",
    "preact-render-to-string": "^6.5.13",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.81.0"
  },
  "name": "forklight",
  "private": true,
  "scripts": {
    "build": "pracht build",
    "dev": "pracht dev",
    "typecheck": "tsc --noEmit",
    "deploy": "pracht build && wrangler deploy",
    "preview": "pracht preview",
    "db:migrate": "wrangler d1 migrations apply forklight-db --local",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval": "pracht eval --url http://localhost:4790 --start \"pracht preview --port 4790\"",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run eval && pnpm run test:e2e"
  },
  "type": "module",
  "version": "0.0.0"
}
