{
  "name": "incident investigation flow",
  "task": "Orient on INC-2107, pull evidence, fork BOTH candidate mitigations, simulate each, compare them, and stage whichever the comparison recommends — the whole demo prompt, over the HTTP projection. The recommendation must be earned against a real alternative, and the staged mitigation must follow from it.",
  "steps": [
    {
      "capability": "incident.reset",
      "input": {},
      "headers": { "x-forklight-session": "eval-incident-flow" },
      "expect": { "ok": true, "status": 200, "output": { "result": "ok" } }
    },
    {
      "capability": "incident.snapshot",
      "input": {},
      "headers": { "x-forklight-session": "eval-incident-flow" },
      "expect": {
        "ok": true,
        "status": 200,
        "output": {
          "incident": { "id": "INC-2107", "status": "open", "applied": null },
          "clock": "14:32"
        }
      }
    },
    {
      "capability": "signals.query",
      "input": { "signal": "logs:web", "windowMinutes": 30 },
      "headers": { "x-forklight-session": "eval-incident-flow" },
      "expect": {
        "ok": true,
        "status": 200,
        "output": { "result": "ok", "kind": "logs", "label": "web logs" }
      }
    },
    {
      "capability": "scenario.fork",
      "input": {
        "name": "Bypass response cache",
        "hypothesis": "Errors stop if web skips the new edge cache"
      },
      "headers": { "x-forklight-session": "eval-incident-flow" },
      "expect": {
        "ok": true,
        "status": 200,
        "output": { "result": "ok", "scenario": { "id": "s-1", "parent": "main", "actions": [] } }
      }
    },
    {
      "capability": "scenario.fork",
      "input": {
        "name": "Roll back v8.3.1",
        "hypothesis": "Reverting web removes the bad cache entirely"
      },
      "headers": { "x-forklight-session": "eval-incident-flow" },
      "expect": {
        "ok": true,
        "status": 200,
        "output": { "result": "ok", "scenario": { "id": "s-2", "parent": "main", "actions": [] } }
      }
    },
    {
      "capability": "scenario.simulate",
      "input": {
        "scenario": "$steps[3].data.scenario.id",
        "mitigation": "bypass_response_cache"
      },
      "headers": { "x-forklight-session": "eval-incident-flow" },
      "expect": {
        "ok": true,
        "status": 200,
        "output": {
          "result": "ok",
          "assessment": { "recoveryEtaMinutes": 4, "recoveryAtClock": "14:36", "confidence": 0.86 }
        }
      }
    },
    {
      "capability": "scenario.simulate",
      "input": {
        "scenario": "$steps[4].data.scenario.id",
        "mitigation": "rollback_deploy"
      },
      "headers": { "x-forklight-session": "eval-incident-flow" },
      "expect": {
        "ok": true,
        "status": 200,
        "output": {
          "result": "ok",
          "assessment": { "recoveryEtaMinutes": 8, "recoveryAtClock": "14:40", "confidence": 0.92 }
        }
      }
    },
    {
      "capability": "scenario.compare",
      "input": {},
      "headers": { "x-forklight-session": "eval-incident-flow" },
      "expect": {
        "ok": true,
        "status": 200,
        "output": {
          "result": "ok",
          "recommendation": { "scenarioId": "s-2", "name": "Roll back v8.3.1" }
        }
      }
    },
    {
      "capability": "mitigation.stage",
      "input": {
        "scenario": "$steps[7].data.recommendation.scenarioId",
        "rationale": "Highest confidence (92%) with the lowest blast radius; four minutes slower than the bypass, but it removes the broken cache instead of masking it.",
        "evidence": ["web_error_rate 14:05-14:32", "edge-cache key fragmentation warnings", "scenario.compare ranking"]
      },
      "headers": { "x-forklight-session": "eval-incident-flow" },
      "expect": {
        "ok": true,
        "status": 200,
        "output": {
          "result": "ok",
          "staged": { "mitigation": "rollback_deploy", "status": "staged", "stagedVia": "http" }
        }
      }
    },
    {
      "capability": "incident.snapshot",
      "input": {},
      "headers": { "x-forklight-session": "eval-incident-flow" },
      "expect": {
        "ok": true,
        "status": 200,
        "output": { "incident": { "status": "open", "applied": null } }
      }
    }
  ]
}
