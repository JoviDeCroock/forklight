{
  "name": "incident investigation flow",
  "task": "Orient on INC-2107, pull evidence, fork competing counterfactuals, simulate bypass and rollback, compare them, and stage the recommended result for a human — the whole demo prompt, over the HTTP projection.",
  "steps": [
    {
      "capability": "incident.reset",
      "input": {},
      "headers": { "x-forklight-session": "eval-incident-flow" },
      "expect": { "ok": true, "status": 200, "output": { "result": "ok" } }
    },
    {
      "capability": "incident.snapshot",
      "input": {},
      "headers": { "x-forklight-session": "eval-incident-flow" },
      "expect": {
        "ok": true,
        "status": 200,
        "output": {
          "incident": { "id": "INC-2107", "status": "open", "applied": null },
          "clock": "14:32"
        }
      }
    },
    {
      "capability": "signals.query",
      "input": { "signal": "logs:web", "windowMinutes": 30 },
      "headers": { "x-forklight-session": "eval-incident-flow" },
      "expect": {
        "ok": true,
        "status": 200,
        "output": { "result": "ok", "kind": "logs", "label": "web logs" }
      }
    },
    {
      "capability": "scenario.fork",
      "input": {
        "name": "Bypass response cache",
        "hypothesis": "Errors stop if web skips the new edge cache"
      },
      "headers": { "x-forklight-session": "eval-incident-flow" },
      "expect": {
        "ok": true,
        "status": 200,
        "output": { "result": "ok", "scenario": { "id": "s-1", "parent": "main", "actions": [] } }
      }
    },
    {
      "capability": "scenario.simulate",
      "input": {
        "scenario": "$steps[3].data.scenario.id",
        "mitigation": "bypass_response_cache"
      },
      "headers": { "x-forklight-session": "eval-incident-flow" },
      "expect": {
        "ok": true,
        "status": 200,
        "output": {
          "result": "ok",
          "assessment": { "recoveryEtaMinutes": 4, "recoveryAtClock": "14:36", "confidence": 0.86 }
        }
      }
    },
    {
      "capability": "scenario.fork",
      "input": {
        "name": "Rollback deployment",
        "hypothesis": "Returning web to v8.3.0 stops the regression with a smaller blast radius"
      },
      "headers": { "x-forklight-session": "eval-incident-flow" },
      "expect": {
        "ok": true,
        "status": 200,
        "output": { "result": "ok", "scenario": { "id": "s-2", "parent": "main", "actions": [] } }
      }
    },
    {
      "capability": "scenario.simulate",
      "input": {
        "scenario": "$steps[5].data.scenario.id",
        "mitigation": "rollback_deploy"
      },
      "headers": { "x-forklight-session": "eval-incident-flow" },
      "expect": {
        "ok": true,
        "status": 200,
        "output": {
          "result": "ok",
          "assessment": { "confidence": 0.92, "blastRadius": { "level": "low" } }
        }
      }
    },
    {
      "capability": "scenario.compare",
      "input": {
        "scenarios": ["$steps[3].data.scenario.id", "$steps[5].data.scenario.id"]
      },
      "headers": { "x-forklight-session": "eval-incident-flow" },
      "expect": {
        "ok": true,
        "status": 200,
        "output": {
          "result": "ok",
          "recommendation": { "scenarioId": "s-2", "name": "Rollback deployment" }
        }
      }
    },
    {
      "capability": "mitigation.stage",
      "input": {
        "scenario": "$steps[5].data.scenario.id",
        "rationale": "The comparator ranks rollback first on confidence and blast radius; it is slower than bypass but remains reversible and avoids shifting cache load to the primary database.",
        "evidence": ["web_error_rate 14:05-14:32", "v8.3.1 response-cache key fragmentation warnings"]
      },
      "headers": { "x-forklight-session": "eval-incident-flow" },
      "expect": {
        "ok": true,
        "status": 200,
        "output": {
          "result": "ok",
          "staged": { "mitigation": "rollback_deploy", "status": "staged", "stagedVia": "http" }
        }
      }
    },
    {
      "capability": "incident.snapshot",
      "input": {},
      "headers": { "x-forklight-session": "eval-incident-flow" },
      "expect": {
        "ok": true,
        "status": 200,
        "output": { "incident": { "status": "open", "applied": null } }
      }
    }
  ]
}
